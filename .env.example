# Copiá este archivo como .env y completá tus claves. El .env no se sube a git.
# El proveedor (OpenAI o Anthropic) se elige por consola al ejecutar main.py.

# Claves de API (solo es obligatoria la del proveedor que elijas)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Opcional: cambiar el modelo por defecto de cada proveedor
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-3.8-flash

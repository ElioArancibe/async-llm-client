# Copiá este archivo como .env y completá tus claves. El .env no se sube a git.

# Proveedor a usar: openai | anthropic
LLM_PROVIDER=openai

# Claves de API (solo es obligatoria la del proveedor elegido)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: sobrescribir el modelo por defecto de cada proveedor
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_MODEL=claude-opus-5-5
